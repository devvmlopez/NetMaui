<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InntecMobileNetMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:InntecMobileNetMaui"
    xmlns:login="clr-namespace:InntecMobileNetMaui.Views.Login"
    xmlns:cards="clr-namespace:InntecMobileNetMaui.Views.Cards"
    xmlns:views="clr-namespace:InntecMobileNetMaui.Views"
    xmlns:faq="clr-namespace:InntecMobileNetMaui.Views.FAQ"
    xmlns:notify="clr-namespace:InntecMobileNetMaui.Views.Notify"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate login:LoginPage}"
        Route="Login" />
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:MyDataPage}"
        Route="MyDatePage"/>
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate cards:CardsPage}"
        Route="CardsPage"/>
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage"/>
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate cards:CardDetailPage}"
        Route="CardDetailPage"/>
     <ShellContent
         Shell.NavBarIsVisible="False"
         ContentTemplate="{DataTemplate views:TermsAndConditionsPage}"
         Route="TermsAndConditionsPage"/>
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:RecoverPasswordPage}"
        Route="RecoverPasswordPage"/>
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate faq:FAQmenu}"
        Route="FAGsPage"/>
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate notify:NotityPage}"
        Route="NotifyPage"/>
    <ShellContent
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:OptionsPage}"
        Route="OptionsPage"/>
</Shell>
