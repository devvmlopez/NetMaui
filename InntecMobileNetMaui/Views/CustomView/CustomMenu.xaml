<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InntecMobileNetMaui.Views.CustomView.CustomMenu"
             x:Name="thisView">
    <Frame
        BackgroundColor="{OnPlatform iOS={AppThemeBinding Dark='White', Light='#d3d3d3E6'} , Android= {AppThemeBinding Dark='#d3d3d3E6', Light='#d3d3d3E6'}}"
        HasShadow="{AppThemeBinding Dark='false', Light='true'}"
        Margin="4"
        CornerRadius="20"
        IsClippedToBounds="True"
        BorderColor="{AppThemeBinding Light='Gray', Dark='LightGray'}"
        HorizontalOptions="CenterAndExpand" >
        <Grid
            BackgroundColor="Transparent"
            Margin="-4"
            HeightRequest="70"
            Padding="8,0"
            RowSpacing="0"
            ColumnDefinitions="*,*,*,*,*"
            RowDefinitions="*,5"
            >
            <Image
                Grid.Column="0"
                Grid.Row="0"
                HeightRequest="50"
                WidthRequest="50"
                Margin="8,0"
                HorizontalOptions="Center"
                IsEnabled="{Binding IconIzqEnable}"
                BindingContext="{Reference thisView}"
                >
                <Image.Source>
                    <FileImageSource File="{Binding IconIzq}"/>
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapIconoIzq_Tapped"/>
                </Image.GestureRecognizers>
            </Image>
            <BoxView
                 Grid.Column="0"
                 Grid.Row="1"
                 HeightRequest="5"
                 Margin="0,-4,0,8"
                 IsEnabled="{Binding IconIzqEnable}"
                 BindingContext="{Reference thisView}"
                 Color="#367fb6">
                <BoxView.Triggers>
                    <DataTrigger 
                         TargetType="BoxView"
                         Binding="{Binding IconIzqEnable}"
                         Value="True">
                        <Setter 
                         Property="IsVisible"
                         Value="False" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <Image
                Grid.Column="1"
                Grid.Row="0"
                HeightRequest="50"
                WidthRequest="50"
                Margin="8,0"
                HorizontalOptions="Center"
                IsEnabled="{Binding IconCentroIzqEnable}"
                BindingContext="{Reference thisView}"
                >
                <Image.Source>
                    <FileImageSource File="{Binding IconCentroIzq}"/>
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapIconoCentroIzq_Tapped"/>
                </Image.GestureRecognizers>
            </Image>
            <BoxView
                Grid.Column="1"
                Grid.Row="1"
                HeightRequest="5"
                Margin="0,-4,0,8"
                IsEnabled="{Binding IconCentroIzqEnable}"
                BindingContext="{Reference thisView}"
                Color="#367fb6">
                <BoxView.Triggers>
                    <DataTrigger 
                        TargetType="BoxView"
                        Binding="{Binding IconCentroIzqEnable}"
                        Value="True">
                        <Setter 
                            Property="IsVisible"
                            Value="False" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <Image
                Grid.Column="2"
                Grid.Row="0"
                HeightRequest="55"
                WidthRequest="55"
                Margin="8,0"
                HorizontalOptions="Center"
                IsEnabled="{Binding IconCentroEnable}"
                BindingContext="{Reference thisView}"
                >
                <Image.Source>
                    <FileImageSource File="{Binding IconCentro}"/>
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapIconoCentro_Tapped"/>
                </Image.GestureRecognizers>
            </Image>
            <BoxView
                Grid.Column="2"
                Grid.Row="1"
                HeightRequest="5"
                Margin="0,-4,0,8"
                IsEnabled="{Binding IconCentroEnable}"
                BindingContext="{Reference thisView}"
                Color="#367fb6">
                <BoxView.Triggers>
                    <DataTrigger 
                        TargetType="BoxView"
                        Binding="{Binding IconCentroEnable}"
                        Value="True">
                        <Setter 
                            Property="IsVisible"
                            Value="False" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <Image
                Grid.Column="3"
                Grid.Row="0"
                HeightRequest="50"
                WidthRequest="50"
                Margin="8,0"
                HorizontalOptions="Center"
                IsEnabled="{Binding IconCentroDerEnable}"
                BindingContext="{Reference thisView}"
                >
                <Image.Source>
                    <FileImageSource File="{Binding IconCentroDer}"/>
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapIconoCentroDer_Tapped"/>
                </Image.GestureRecognizers>
            </Image>
            <BoxView
                Grid.Column="3"
                Grid.Row="1"
                HeightRequest="5"
                Margin="0,-4,0,8"
                IsEnabled="{Binding IconCentroDerEnable}"
                BindingContext="{Reference thisView}"
                Color="#367fb6">
                <BoxView.Triggers>
                    <DataTrigger 
                        TargetType="BoxView"
                        Binding="{Binding IconCentroDerEnable}"
                        Value="True">
                        <Setter 
                            Property="IsVisible"
                            Value="False" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <Image
                Grid.Column="4"
                Grid.Row="0"
                HeightRequest="50"
                WidthRequest="50"
                Margin="8,0"
                HorizontalOptions="Center"
                IsEnabled="{Binding IconDerEnable}"
                BindingContext="{Reference thisView}"
                >
                <Image.Source>
                    <FileImageSource File="{Binding IconDer}"/>
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapIconoDer_Tapped"/>
                </Image.GestureRecognizers>
            </Image>
            <BoxView
                Grid.Column="4"
                Grid.Row="1"
                HeightRequest="5"
                Margin="0,-4,0,8"
                IsEnabled="{Binding IconDerEnable}"
                BindingContext="{Reference thisView}"
                Color="#367fb6">
                <BoxView.Triggers>
                    <DataTrigger 
                        TargetType="BoxView"
                        Binding="{Binding IconDerEnable}"
                        Value="True">
                        <Setter 
                            Property="IsVisible"
                            Value="False" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>
        </Grid>

    </Frame>

</ContentView>
