<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InntecMobileNetMaui.Views.Asistencia.AssistPage"
             Title="AssistPage">
    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="#49A0F0" 
                  Padding="0"
                  Orientation="Horizontal">
            <Image Source="inntecw.png"
                HeightRequest="60"
                Margin="10,0,0,0"
                HorizontalOptions="Start"
                />
            <ImageButton x:Name="BtnClose"
                      Source="delete.png"
                      HeightRequest="20"
                      Margin="0,0,20,0"
                      BackgroundColor="Transparent"
                      HorizontalOptions="EndAndExpand"/>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>

        <StackLayout BackgroundColor="#49A0F0">
            <StackLayout HorizontalOptions="FillAndExpand"
                      BackgroundColor="#608AC4E1"
                      Margin="0,10,0,0">
                <Label Text="Retira efectivo en cajeros INBURSA" 
                    FontSize="Large"
                    Margin="10"
                    TextColor="White"
                    HorizontalTextAlignment="End"></Label>
            </StackLayout>
            <Image Source="people.png"
                Margin="10"/>
            <Label Text="INCLUYE"
                HorizontalOptions="Center"
                FontSize="Large"
                FontAttributes="Bold"/>
            <StackLayout Orientation="Horizontal">
                <StackLayout Padding="10,0,0,0">
                    <Label Text="• $ 1000 en Medicamentos"
                    TextColor="White"/>
                    <Label Text="• Consulta y Limpieza Dental"
                    TextColor="White"/>
                    <Label Text="• Asistencia Medica y Funeraria"
                    TextColor="White"/>
                    <Label Text="• Ambulancia Terrestre"
                    TextColor="White"/>
                    <Label Text="• Asistencia Cerrajero, Plomero, Electricista y PC"
                    TextColor="White"/>
                    <Label Text="• Proteccion por robo en cajero"
                    TextColor="White"/>
                    <Label Text="• Y muchas asistencias mas..."
                    TextColor="White"/>
                </StackLayout>
                <StackLayout VerticalOptions="FillAndExpand">
                    <Button x:Name="BtnActivate"
                         Text="Activar Beneficios"
                         HorizontalOptions="CenterAndExpand"
                         VerticalOptions="CenterAndExpand"
                         WidthRequest="120"
                         Margin="0,0,10,0"
                         CornerRadius="5"
                         BackgroundColor="#3487CB"
                         TextColor="White"
                         />
                </StackLayout>
            </StackLayout>
            <AbsoluteLayout AbsoluteLayout.LayoutBounds="0,0,1,1" 
                         AbsoluteLayout.LayoutFlags="All">
                <Image Source="footer.png"
                    AbsoluteLayout.LayoutBounds="0,0,1,1" 
                    AbsoluteLayout.LayoutFlags="All"
                    Margin="0,0,-10,0"
                    HorizontalOptions="EndAndExpand"
                    VerticalOptions="EndAndExpand"/>
                <Button  x:Name="BtnTerm"
                      AbsoluteLayout.LayoutBounds="0,0,1,1" 
                      AbsoluteLayout.LayoutFlags="All"
                      BackgroundColor="Transparent"
                      TextColor="White"
                      Margin="5"
                      Text="Terminos y condiciones"
                      HorizontalOptions="EndAndExpand"
                      VerticalOptions="EndAndExpand"/>

            </AbsoluteLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>